# HYGO Configuration Template
# Copy this file to .env and fill in your values

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vision-capable model from OpenRouter
# Examples:
#   - openai/gpt-4o-mini (recommended, cost-effective)
#   - openai/gpt-4o (more capable, higher cost)
#   - anthropic/claude-3-5-sonnet (alternative)
#   - google/gemini-pro-vision (alternative)
# See available models: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: HTTP Referer for request tracking
OPENROUTER_HTTP_REFERER=http://localhost

# Optional: Application title for OpenRouter dashboard
OPENROUTER_APP_TITLE=hygo-vision-agent