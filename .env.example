# HYGO Configuration Template
# Copy this file to .env and fill in your values

# OpenRouter API Configuration
# Get your API key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vision-capable model from OpenRouter
# Examples:
#   - openai/gpt-4o-mini (recommended, cost-effective)
#   - openai/gpt-4o (more capable, higher cost)
#   - anthropic/claude-3-5-sonnet (alternative)
#   - google/gemini-pro-vision (alternative)
# See available models: https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: HTTP Referer for request tracking
OPENROUTER_HTTP_REFERER=http://localhost

# Optional: Application title for OpenRouter dashboard
OPENROUTER_APP_TITLE=hygo-vision-agent

# TEST_ALL Mode: Set to true to test all fallback models sequentially
# When enabled, processes all images with each model and stores results separately
# Default: false (only use OPENROUTER_MODEL)
TEST_ALL=false

# Database Path: SQLite database file for storing analysis results
# Default: hygo_results.db (in project root)
DATABASE_PATH=hygo_results.db

# Note for Anando Prokumar:
# Run the following to update the environment and register the kernel before using the notebooks:
# conda env update -f environment.yaml --prune -n vision-agent
# conda run -n vision-agent python -m ipykernel install --user --name vision-agent --display-name "vision-agent"